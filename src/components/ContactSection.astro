---
import { useT, type Lang } from '../i18n/ui';
import Form from './Form.astro';
import SocialLinks from './SocialLinks.astro';
import Icon from './Icon.astro';
interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useT(lang);
---
<section id="contact" class="grid scroll-mt-28 gap-space-lg rounded-2xl border border-white/[0.06] bg-surface-container p-5 lg:grid-cols-12 lg:gap-space-xl lg:p-8">
  <div class="flex flex-col gap-space-sm lg:col-span-5">
    <h2 class="flex items-center gap-2 text-headline-md font-bold text-on-surface"><Icon name="mail" class="text-secondary" size="1.5rem" />{t('contact.title')}</h2>
    <p class="text-body-md text-on-surface-variant">{t('contact.lead')}</p>
    <span class="mt-2 font-mono text-label-sm uppercase tracking-wider text-outline">{t('contact.direct')}</span>
    <SocialLinks />
  </div>
  <Form kind="contact" lang={lang} subject={lang === "es" ? "Contacto desde el sitio" : "Contact from the website"} class="lg:col-span-7">
    <div class="grid gap-space-sm sm:grid-cols-2">
      <div><label class="field-label" for="c-name">{t('form.name')}</label><input id="c-name" name="name" class="field" required autocomplete="name" /></div>
      <div><label class="field-label" for="c-email">{t('form.email')}</label><input id="c-email" name="email" type="email" class="field" required autocomplete="email" placeholder={t('form.placeholder.email')} /></div>
    </div>
    <div><label class="field-label" for="c-msg">{t('form.message')}</label><textarea id="c-msg" name="message" rows="4" class="field" required></textarea></div>
  </Form>
</section>
