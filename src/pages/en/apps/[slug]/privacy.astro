---
import View from '../../../../views/PrivacyPage.astro';
import { getApps, policyFor, slugOf } from '../../../../lib/apps';
export async function getStaticPaths() {
  const out = [];
  for (const app of await getApps('en')) {
    if (app.data.privacyUrl) continue;
    const policy = await policyFor('en', slugOf(app.id));
    if (policy) out.push({ params: { slug: slugOf(app.id) }, props: { app, policy } });
  }
  return out;
}
const { app, policy } = Astro.props;
---
<View lang="en" app={app} policy={policy} />
