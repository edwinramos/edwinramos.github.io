---
import type { Lang } from '../i18n/ui';
interface Props { lang: Lang; alternates: Record<Lang, string> }
const { lang, alternates } = Astro.props;
const items: { code: Lang; label: string }[] = [{ code: 'es', label: 'ES' }, { code: 'en', label: 'EN' }];
---
<nav aria-label="Idioma / Language" class="flex items-center rounded-full bg-surface-container-high p-0.5">
  {items.map(({ code, label }) => (
    code === lang
      ? <span aria-current="true" class="flex min-h-8 items-center justify-center rounded-full bg-surface-container-highest px-2.5 py-1 font-mono text-label-sm font-semibold text-secondary shadow-[0_0_12px_rgba(123,208,255,0.25)]">{label}</span>
      : <a href={alternates[code]} hreflang={code} lang={code} class="flex min-h-8 items-center justify-center rounded-full px-2 py-1 font-mono text-label-sm text-outline transition-colors hover:text-on-surface">{label}</a>
  ))}
</nav>
