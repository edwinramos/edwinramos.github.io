---
/** App card (home grid + apps list). */
import type { CollectionEntry } from 'astro:content';
import { useT, type Lang } from '../i18n/ui';
import { href } from '../lib/paths';
import { slugOf, platformName } from '../lib/apps';
import Icon from './Icon.astro';
import AppIcon from './AppIcon.astro';
import StatusPill from './StatusPill.astro';
import ExampleBadge from './ExampleBadge.astro';
interface Props { entry: CollectionEntry<'projects'>; lang: Lang }
const { entry, lang } = Astro.props;
const { data } = entry;
const t = useT(lang);
const url = href(lang, `apps/${slugOf(entry.id)}`);
---
<article class="card-raised card-hover relative flex flex-col gap-space-sm">
  <div class="flex items-start gap-3">
    <AppIcon logo={data.logo} icon={data.icon} title={data.title} />
    <div class="flex min-w-0 flex-1 flex-col gap-1">
      <div class="flex flex-wrap items-center gap-1.5">
        <StatusPill status={data.status} lang={lang} />
        {data.featured && <span class="badge">{t('home.featured')}</span>}
        <ExampleBadge lang={lang} show={data.example} />
      </div>
      <h3 class="text-headline-sm font-bold text-on-surface"><a href={url} class="after:absolute after:inset-0 transition-colors hover:text-primary">{data.title}</a></h3>
    </div>
  </div>
  <p class="text-body-sm text-on-surface-variant">{data.summary}</p>
  <div class="mt-auto flex items-center justify-between gap-2 border-t border-outline-variant/30 pt-2">
    <span class="flex flex-wrap gap-1.5 font-mono text-[11px] text-on-surface-variant">
      {data.platforms.map((p) => <span class="rounded bg-surface-container-high px-1.5 py-0.5">{platformName[p]}</span>)}
      {data.playStoreUrl && <span class="flex items-center gap-0.5 text-emerald-400"><Icon name="shop" size="0.9rem" />Play</span>}
      {data.appStoreUrl && <span class="flex items-center gap-0.5 text-emerald-400"><Icon name="phone_iphone" size="0.9rem" />App Store</span>}
    </span>
    <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-surface-container-low text-on-surface-variant" aria-hidden="true"><Icon name="arrow_forward" size="1.1rem" /></span>
  </div>
</article>
