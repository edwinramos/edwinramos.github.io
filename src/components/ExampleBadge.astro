---
import { useT, type Lang } from '../i18n/ui';
interface Props { lang: Lang; show?: boolean }
const { lang, show = true } = Astro.props;
const t = useT(lang);
---
{show && <span class="inline-flex items-center rounded border border-dashed border-amber-400/50 bg-amber-400/10 px-1.5 py-0.5 font-mono text-[10px] font-semibold uppercase tracking-wider text-amber-300" title={t('common.exampleNote')}>{t('common.example')}</span>}
