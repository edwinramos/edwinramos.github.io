---
/** Header logo: Edwin's profile photo in a small circle (32 px; 64 px files for 2x screens).
 *  Files: public/images/profile-64.webp + profile-64.jpg (fallback). The browser-tab icons (public/favicon.ico, favicon-32.png, apple-touch-icon.png) are separate files. */
import { asset } from '../lib/paths';
interface Props { class?: string }
const { class: cls = 'h-8 w-8' } = Astro.props;
---
<picture class="contents">
  <source type="image/webp" srcset={asset('images/profile-64.webp')} />
  <img src={asset('images/profile-64.jpg')} alt="Edwin Ramos" width="32" height="32" decoding="async"
    class:list={[cls, 'rounded-full object-cover shadow-[0_0_0_1.5px_rgba(208,188,255,0.5)]']} />
</picture>
