---
import type { CollectionEntry } from 'astro:content';
import { useT, type Lang } from '../i18n/ui';
import { href, asset } from '../lib/paths';
import { slugOf } from '../lib/content';
import Icon from './Icon.astro';
import ProgressBar from './ProgressBar.astro';
import TechBadges from './TechBadges.astro';
import ExampleBadge from './ExampleBadge.astro';
interface Props { entry: CollectionEntry<'projects'>; lang: Lang; variant?: 'compact' | 'spotlight' }
const { entry, lang, variant = 'compact' } = Astro.props;
const { data } = entry;
const t = useT(lang);
const url = href(lang, `projects/${slugOf(entry.id)}`);
---
{variant === 'compact' ? (
  <div class="card flex flex-col gap-3">
    <div class="flex items-start justify-between gap-2">
      <div>
        <span class="block font-mono text-[10px] font-semibold uppercase tracking-wider text-primary">{data.title}</span>
        <h3 class="mt-0.5 text-body-lg font-bold text-on-surface">{data.currentTask ?? data.summary}</h3>
      </div>
      {data.progress !== undefined && <span class="shrink-0 rounded-full bg-surface-container-high px-2.5 py-0.5 font-mono text-[11px] text-secondary">{data.progress}%</span>}
    </div>
    <p class="text-body-sm text-on-surface-variant">{data.summary}</p>
    {data.progress !== undefined && <div class="pt-1"><ProgressBar value={data.progress} label={t('projects.sprint')} /></div>}
    <div class="flex items-center justify-between gap-2 pt-1">
      <span class="font-mono text-[11px] text-outline">{data.eta ? `${t('home.eta')}: ${data.eta}` : ''}</span>
      <a href={url} class="flex items-center gap-1 text-[12px] font-semibold text-secondary transition-colors hover:text-primary">{t('home.viewProject')} <Icon name="arrow_forward" size="1rem" /></a>
    </div>
  </div>
) : (
  <div class="card-raised grid gap-space-md lg:grid-cols-2 lg:items-center lg:gap-space-xl lg:p-8">
    <div class="flex flex-col gap-space-md">
      <div class="flex flex-col gap-1">
        <div class="flex items-center justify-between gap-2">
          <span class="font-mono text-label-sm text-secondary">{data.kind}</span>
          <ExampleBadge lang={lang} show={data.example} />
        </div>
        <h3 class="text-headline-md font-bold text-on-surface lg:text-headline-lg">{data.title}</h3>
        <p class="text-body-sm text-on-surface-variant lg:text-body-md">{data.summary}</p>
      </div>
      {data.progress !== undefined && (
        <div class="flex flex-col gap-2 rounded-xl bg-surface-container-low p-space-sm sm:p-space-md">
          <div class="flex items-center justify-between text-body-sm">
            <span class="flex items-center gap-1.5 font-medium text-on-surface"><Icon name="insights" class="text-secondary" size="1.1rem" />{t('projects.sprint')}</span>
            <span class="font-semibold text-secondary">{data.progress}%</span>
          </div>
          <ProgressBar value={data.progress} gradient={false} />
          {data.currentTask && <p class="font-mono text-code-sm text-on-surface-variant">{data.currentTask}</p>}
        </div>
      )}
      <TechBadges tags={data.tags} />
      <div class="grid grid-cols-2 gap-space-xs sm:flex sm:gap-space-sm">
        <a href={url} class="btn-primary py-2.5"><Icon name="visibility" size="1.1rem" />{t('links.details')}</a>
        <a href={data.betaUrl || href(lang, 'feedback#beta')} class="btn-ghost py-2.5 font-semibold text-secondary"><Icon name="install_mobile" size="1.1rem" />{t('links.beta')}</a>
      </div>
    </div>
    <div class="relative h-40 w-full overflow-hidden rounded-xl bg-surface-container-low sm:h-56 lg:h-72">
      {data.cover
        ? <img src={asset(data.cover)} alt={data.title} class="h-full w-full object-cover" loading="lazy" decoding="async" />
        : <div class="flex h-full w-full items-center justify-center bg-[radial-gradient(circle_at_30%_20%,rgba(208,188,255,0.25),transparent_60%),radial-gradient(circle_at_80%_80%,rgba(123,208,255,0.2),transparent_55%)]"><Icon name={data.icon ?? 'rocket_launch'} class="text-primary" size="4rem" /></div>}
      {data.metric && (
        <div class="absolute bottom-2 left-2 flex items-center gap-1 rounded-full bg-surface-container-lowest/80 px-2.5 py-1 backdrop-blur-md">
          <Icon name="bolt" class="text-secondary" size="0.95rem" /><span class="font-mono text-code-sm text-on-surface">{data.metric}</span>
        </div>
      )}
    </div>
  </div>
)}
