---
import { render, type CollectionEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import Giscus from '../components/Giscus.astro';
import ExampleBadge from '../components/ExampleBadge.astro';
import { SITE } from '../config';
import { useT, type Lang } from '../i18n/ui';
import { href, asset, formatDate, readingMinutes } from '../lib/paths';
import { slugOf, hasTranslation } from '../lib/content';
import { appIndex, updatesFor } from '../lib/apps';
import { sharePath, instagramCaption } from '../lib/share';
import AppIcon from '../components/AppIcon.astro';
import ShareKit from '../components/ShareKit.astro';
import StoreBadges from '../components/StoreBadges.astro';
interface Props { lang: Lang; entry: CollectionEntry<'posts'> }
const { lang, entry } = Astro.props;
const { data } = entry;
const t = useT(lang);
const slug = slugOf(entry.id);
const other: Lang = lang === 'es' ? 'en' : 'es';
const alternates = { [other]: (await hasTranslation('posts', other, slug)) ? href(other, `blog/${slug}`) : href(other, 'blog') };
const { Content, headings } = await render(entry);
const toc = headings.filter((h) => h.depth === 2);
const app = data.app ? (await appIndex(lang)).get(data.app) : undefined;
const appSlug = app ? slugOf(app.id) : undefined;
const more = appSlug ? (await updatesFor(lang, appSlug)).filter((p) => p.id !== entry.id).slice(0, 3) : [];
const postUrl = new URL(href(lang, `blog/${slug}`), Astro.site).toString();
const caption = instagramCaption(lang, entry, app, postUrl);
const igPath = sharePath(lang, slug, 'ig');
const ogPath = sharePath(lang, slug, 'og');
---
<Base lang={lang} path={`blog/${slug}`} active="blog" title={data.title} description={data.description} image={data.cover ?? ogPath} type="article" publishedTime={data.date} alternates={alternates}>
  <div class="container-site grid gap-space-lg py-space-md lg:grid-cols-12 lg:gap-space-xl lg:py-space-xl">
    <article class="flex flex-col gap-space-lg lg:col-span-8">
      <a href={href(lang, 'blog')} class="inline-flex w-fit items-center gap-1 font-mono text-label-sm text-on-surface-variant hover:text-secondary"><Icon name="arrow_back" size="1rem" />{t('nav.blog')}</a>
      <header class="flex flex-col gap-space-sm">
        <div class="flex flex-wrap items-center gap-2 font-mono text-[11px] text-on-surface-variant">
          <time datetime={data.date.toISOString()}>{formatDate(data.date, lang, { year: 'numeric', month: 'long', day: 'numeric' })}</time><span>·</span><span>{readingMinutes(entry.body)} {t('common.minRead')}</span>
          {!app && data.version && <span class="badge">{data.version}</span>}
          <ExampleBadge lang={lang} show={data.example} />
        </div>
        {app && (
          <a href={href(lang, `apps/${appSlug}`)} class="flex w-fit items-center gap-2.5 rounded-2xl border border-white/[0.06] bg-surface-container-low py-1.5 pl-1.5 pr-3 transition-colors hover:border-secondary/50">
            <AppIcon logo={app.data.logo} icon={app.data.icon} title={app.data.title} size="sm" />
            <span class="flex flex-col leading-tight"><span class="font-mono text-[10px] uppercase tracking-wider text-outline">{t('post.app')}</span><span class="text-body-md font-semibold text-on-surface">{app.data.title}</span></span>
            {data.version && <span class="badge bg-primary text-on-primary">{data.version}</span>}
          </a>
        )}
        <h1 class="text-headline-lg-mobile font-bold tracking-tight text-on-surface lg:text-headline-lg">{data.title}</h1>
        <p class="text-body-md text-on-surface-variant lg:text-body-lg">{data.description}</p>
        <div class="flex items-center gap-2 pt-1">
          <img src={asset('images/avatar.svg')} alt="" class="h-8 w-8 rounded-full" width="32" height="32" />
          <span class="text-body-sm text-on-surface">{SITE.name}</span>
        </div>
      </header>
      {data.cover && <img src={asset(data.cover)} alt="" class="w-full rounded-2xl" />}
      <div class="prose prose-site"><Content /></div>
      <ul class="flex flex-wrap gap-1.5">{data.tags.map((tag) => <li class="chip"><Icon name="tag" size="0.9rem" />{tag}</li>)}</ul>
      {app && (
        <section class="flex flex-col gap-space-sm rounded-2xl bg-surface-container-low p-4 lg:p-5">
          <div class="flex flex-wrap items-center justify-between gap-2">
            <h2 class="text-body-lg font-semibold text-on-surface">{t('post.moreUpdates')} {app.data.title}</h2>
            <a href={`${href(lang, `apps/${appSlug}`)}#updates`} class="flex items-center gap-1 text-body-sm font-semibold text-secondary hover:text-primary">{t('apps.updates')} <Icon name="arrow_forward" size="1rem" /></a>
          </div>
          {more.length > 0 && <ul class="flex flex-col gap-1.5">{more.map((p) => <li><a href={href(lang, `blog/${slugOf(p.id)}`)} class="flex items-center gap-2 text-body-sm text-on-surface-variant hover:text-on-surface">{p.data.version && <span class="badge">{p.data.version}</span>}{p.data.title}</a></li>)}</ul>}
          <StoreBadges entry={app} lang={lang} />
        </section>
      )}
      <ShareKit lang={lang} slug={slug} caption={caption} igPath={igPath} ogPath={ogPath} />
      <section class="flex flex-col gap-space-sm" id="comments">
        <h2 class="flex items-center gap-2 text-headline-sm font-semibold text-on-surface"><Icon name="forum" class="text-secondary" size="1.25rem" />{t('blog.comments')}</h2>
        <Giscus lang={lang} mode="comments" />
      </section>
    </article>
    <aside class="hidden lg:col-span-4 lg:block">
      <div class="sticky top-28 flex flex-col gap-space-md">
        {toc.length > 0 && (
          <nav class="card" aria-label="Table of contents">
            <span class="section-tag">{lang === 'es' ? 'En este artículo' : 'In this article'}</span>
            <ul class="mt-3 flex flex-col gap-2 border-l border-outline-variant/40 pl-3">
              {toc.map((h) => <li><a href={`#${h.slug}`} class="text-body-sm text-on-surface-variant hover:text-secondary">{h.text}</a></li>)}
            </ul>
          </nav>
        )}
        <div class="card flex flex-col gap-2">
          <h2 class="text-body-lg font-semibold text-on-surface">{t('home.hire.title')}</h2>
          <p class="text-body-sm text-on-surface-variant">{t('home.hire.text')}</p>
          <a href={href(lang, 'services#contact')} class="btn-ghost btn-sm mt-1"><Icon name="handshake" size="1rem" />{t('nav.hire')}</a>
        </div>
      </div>
    </aside>
  </div>
</Base>
