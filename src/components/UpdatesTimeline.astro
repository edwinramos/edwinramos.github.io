---
/** Vertical version timeline for one app (newest first). */
import type { CollectionEntry } from 'astro:content';
import { useT, type Lang } from '../i18n/ui';
import { href, formatDate } from '../lib/paths';
import { slugOf } from '../lib/content';
import Icon from './Icon.astro';
import ExampleBadge from './ExampleBadge.astro';
interface Props { posts: CollectionEntry<'posts'>[]; lang: Lang }
const { posts, lang } = Astro.props;
const t = useT(lang);
---
{posts.length === 0 ? (
  <div class="card flex items-center gap-3 border border-dashed border-outline-variant/50 bg-transparent text-body-sm text-on-surface-variant">
    <Icon name="history_edu" class="text-outline" size="1.4rem" />{t('apps.updates.empty')}
  </div>
) : (
  <ol class="relative flex flex-col gap-space-sm border-l-2 border-outline-variant/40 pl-5">
    {posts.map((p, i) => (
      <li class="relative">
        <span class:list={['absolute -left-[1.72rem] top-4 h-3 w-3 rounded-full ring-4 ring-surface', i === 0 ? 'bg-secondary' : 'bg-outline-variant']}></span>
        <a href={href(lang, `blog/${slugOf(p.id)}`)} class="card card-hover flex flex-col gap-1 border border-transparent">
          <div class="flex flex-wrap items-center gap-2">
            {p.data.version && <span class:list={['badge', i === 0 && 'bg-primary text-on-primary']}>{p.data.version}</span>}
            <time class="font-mono text-[11px] text-outline" datetime={p.data.date.toISOString()}>{formatDate(p.data.date, lang, { year: 'numeric', month: 'short', day: 'numeric' })}</time>
            <ExampleBadge lang={lang} show={p.data.example} />
          </div>
          <span class="text-body-lg font-semibold text-on-surface">{p.data.title}</span>
          <span class="text-body-sm text-on-surface-variant">{p.data.description}</span>
        </a>
      </li>
    ))}
  </ol>
)}
