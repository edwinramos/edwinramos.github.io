---
import { useT, type Lang } from '../i18n/ui';
import { href } from '../lib/paths';
import Icon from './Icon.astro';
interface Props { lang: Lang; active: string }
const { lang, active } = Astro.props;
const t = useT(lang);
const items = [
  { key: 'home', path: '', icon: 'home', label: t('nav.home') },
  { key: 'projects', path: 'apps', icon: 'apps', label: t('nav.projects') },
  { key: 'blog', path: 'blog', icon: 'article', label: t('nav.blog') },
  { key: 'roadmap', path: 'roadmap', icon: 'map', label: t('nav.roadmap') },
  { key: 'about', path: 'about', icon: 'person', label: t('nav.profile') },
];
---
<nav aria-label="Mobile" class="fixed inset-x-0 bottom-0 z-50 bg-surface-container-low/95 pb-safe shadow-[0_-4px_24px_rgba(6,14,32,0.6)] backdrop-blur-xl lg:hidden">
  <ul class="mx-auto grid h-16 max-w-screen-md grid-cols-5 items-center gap-1 px-2">
    {items.map((i) => (
      <li>
        <a href={href(lang, i.path)} aria-current={active === i.key ? 'page' : undefined}
          class:list={['flex min-h-11 flex-col items-center justify-center gap-0.5 rounded-xl py-1.5 transition-all',
            active === i.key ? 'bg-surface-container-highest text-secondary shadow-[0_0_12px_rgba(123,208,255,0.2)]' : 'text-on-surface-variant hover:text-on-surface']}>
          <Icon name={i.icon} size="1.4rem" />
          <span class="font-mono text-[10px] font-semibold tracking-wide">{i.label}</span>
        </a>
      </li>
    ))}
  </ul>
</nav>
