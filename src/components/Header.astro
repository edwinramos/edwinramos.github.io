---
import { SITE } from '../config';
import { useT, type Lang } from '../i18n/ui';
import { href } from '../lib/paths';
import Icon from './Icon.astro';
import Logo from './Logo.astro';
import LangSwitch from './LangSwitch.astro';
interface Props { lang: Lang; active: string; alternates: Record<Lang, string> }
const { lang, active, alternates } = Astro.props;
const t = useT(lang);
const nav = [
  { key: 'home', path: '', label: t('nav.home') },
  { key: 'projects', path: 'projects', label: t('nav.projects') },
  { key: 'blog', path: 'blog', label: t('nav.blog') },
  { key: 'roadmap', path: 'roadmap', label: t('nav.roadmap') },
  { key: 'services', path: 'services', label: t('nav.services') },
  { key: 'about', path: 'about', label: t('nav.about') },
];
---
<header class="fixed inset-x-0 top-0 z-50 border-b border-white/[0.06] bg-surface/85 pt-safe shadow-[0_4px_20px_rgba(6,14,32,0.45)] backdrop-blur-xl">
  <div class="container-site flex h-20 items-center justify-between gap-2">
    <a href={href(lang)} class="flex min-w-0 items-center gap-space-sm" aria-label={SITE.name}>
      <Logo class="h-8 w-8 shrink-0" />
      <div class="flex min-w-0 flex-col">
        <div class="flex items-center gap-space-xs">
          <span class="truncate text-headline-sm font-semibold tracking-tight text-on-surface">{SITE.shortName}</span>
          <span class="shrink-0 rounded bg-surface-container-high px-1.5 py-0.5 font-mono text-[10px] text-secondary">.NET · AI</span>
        </div>
        <div class="flex items-center gap-1.5">
          <span class:list={['h-2 w-2 shrink-0 rounded-full', SITE.available ? 'bg-emerald-400 animate-pulse-indicator' : 'bg-amber-400']}></span>
          <span class="truncate font-mono text-[10px] uppercase tracking-wider text-on-surface-variant">{SITE.available ? t('header.available') : t('header.unavailable')}</span>
        </div>
      </div>
    </a>
    <nav aria-label="Main" class="hidden lg:block">
      <ul class="flex items-center gap-1 rounded-full border border-white/[0.06] bg-surface-container-low/70 p-1">
        {nav.map((n) => (
          <li>
            <a href={href(lang, n.path)} aria-current={active === n.key ? 'page' : undefined}
              class:list={['block rounded-full px-3.5 py-1.5 text-body-sm font-medium transition-colors',
                active === n.key ? 'bg-surface-container-highest text-secondary shadow-[0_0_12px_rgba(123,208,255,0.2)]' : 'text-on-surface-variant hover:text-on-surface']}>{n.label}</a>
          </li>
        ))}
      </ul>
    </nav>
    <div class="flex shrink-0 items-center gap-space-xs sm:gap-space-sm">
      <LangSwitch lang={lang} alternates={alternates} />
      <a href={href(lang, 'services#contact')} class="hidden btn-primary btn-sm sm:inline-flex"><Icon name="handshake" size="1.1rem" />{t('nav.hire')}</a>
      <a href={href(lang, 'services#contact')} aria-label={t('nav.hire')} class="flex h-10 w-10 items-center justify-center rounded-full bg-surface-container-high text-primary transition-colors hover:bg-surface-container-highest sm:hidden"><Icon name="handshake" size="1.25rem" /></a>
    </div>
  </div>
</header>
