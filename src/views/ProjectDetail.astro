---
import { render, type CollectionEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import StatusPill from '../components/StatusPill.astro';
import TechBadges from '../components/TechBadges.astro';
import ProjectLinks from '../components/ProjectLinks.astro';
import ProgressBar from '../components/ProgressBar.astro';
import ExampleBadge from '../components/ExampleBadge.astro';
import { useT, type Lang } from '../i18n/ui';
import { href, asset, formatDate } from '../lib/paths';
import { slugOf, hasTranslation } from '../lib/content';
interface Props { lang: Lang; entry: CollectionEntry<'projects'> }
const { lang, entry } = Astro.props;
const { data } = entry;
const t = useT(lang);
const slug = slugOf(entry.id);
const other: Lang = lang === 'es' ? 'en' : 'es';
const alternates = { [other]: (await hasTranslation('projects', other, slug)) ? href(other, `projects/${slug}`) : href(other, 'projects') };
const { Content } = await render(entry);
const hasLinks = [data.repoUrl, data.playStoreUrl, data.appStoreUrl, data.betaUrl, data.demoUrl].some(Boolean);
---
<Base lang={lang} path={`projects/${slug}`} active="projects" title={data.title} description={data.summary} image={data.cover} alternates={alternates}>
  <article class="container-site grid gap-space-lg py-space-md lg:grid-cols-12 lg:gap-space-xl lg:py-space-xl">
    <div class="flex flex-col gap-space-lg lg:col-span-8">
      <a href={href(lang, 'projects')} class="inline-flex w-fit items-center gap-1 font-mono text-label-sm text-on-surface-variant hover:text-secondary"><Icon name="arrow_back" size="1rem" />{t('nav.projects')}</a>
      <header class="flex flex-col gap-space-sm">
        <div class="flex flex-wrap items-center gap-2">
          <StatusPill status={data.status} lang={lang} />
          {data.kind && <span class="font-mono text-label-sm text-secondary">{data.kind}</span>}
          <ExampleBadge lang={lang} show={data.example} />
        </div>
        <h1 class="text-headline-lg-mobile font-bold tracking-tight text-on-surface lg:text-headline-lg">{data.title}</h1>
        <p class="text-body-md text-on-surface-variant lg:text-body-lg">{data.summary}</p>
      </header>
      <div class="relative h-48 w-full overflow-hidden rounded-2xl bg-surface-container-low sm:h-72">
        {data.cover
          ? <img src={asset(data.cover)} alt={data.title} class="h-full w-full object-cover" />
          : <div class="flex h-full w-full items-center justify-center bg-[radial-gradient(circle_at_30%_20%,rgba(208,188,255,0.25),transparent_60%),radial-gradient(circle_at_80%_80%,rgba(123,208,255,0.2),transparent_55%)]"><Icon name={data.icon ?? 'rocket_launch'} class="text-primary" size="5rem" /></div>}
      </div>
      <div class="prose prose-site"><Content /></div>
    </div>
    <aside class="flex flex-col gap-space-md lg:col-span-4 lg:pt-12">
      <div class="card-raised flex flex-col gap-space-md lg:sticky lg:top-28">
        <div>
          <span class="section-tag">{t('projects.caseStudy')}</span>
          <dl class="mt-2 grid grid-cols-2 gap-3 font-mono text-code-sm">
            {data.version && <div><dt class="text-outline">Version</dt><dd class="text-on-surface">{data.version}</dd></div>}
            <div><dt class="text-outline">{t('common.updated')}</dt><dd class="text-on-surface">{formatDate(data.date, lang)}</dd></div>
            {data.metric && <div class="col-span-2"><dt class="text-outline">KPI</dt><dd class="text-emerald-400">{data.metric}</dd></div>}
          </dl>
        </div>
        {data.progress !== undefined && data.status !== 'live' && (
          <div class="flex flex-col gap-2">
            <div class="flex justify-between text-body-sm"><span class="text-on-surface">{t('projects.sprint')}</span><span class="font-semibold text-secondary">{data.progress}%</span></div>
            <ProgressBar value={data.progress} />
            {data.currentTask && <p class="font-mono text-code-sm text-on-surface-variant">{data.currentTask}</p>}
          </div>
        )}
        <div><span class="section-tag">{t('projects.stack')}</span><div class="mt-2"><TechBadges tags={data.tags} /></div></div>
        {hasLinks && <div><span class="section-tag">{t('projects.links')}</span><div class="mt-2"><ProjectLinks data={data} lang={lang} size="md" /></div></div>}
        <a href={href(lang, 'services#contact')} class="btn-primary"><Icon name="handshake" size="1.1rem" />{t('nav.hire')}</a>
      </div>
    </aside>
  </article>
</Base>
