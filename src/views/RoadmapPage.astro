---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import StatusPill from '../components/StatusPill.astro';
import ExampleBadge from '../components/ExampleBadge.astro';
import { useT, type Lang } from '../i18n/ui';
import { href } from '../lib/paths';
import { byLang, slugOf } from '../lib/content';
interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useT(lang);
const items = (await byLang('roadmap', lang)).sort((a, b) => a.data.order - b.data.order);
const columns = (['in-progress', 'planned', 'idea', 'done'] as const).map((s) => ({ status: s, items: items.filter((i) => i.data.status === s) })).filter((c) => c.items.length);
const icons = { 'in-progress': 'construction', planned: 'flag', idea: 'lightbulb', done: 'check_circle' } as const;
---
<Base lang={lang} path="roadmap" active="roadmap" title={t('roadmap.title')} description={t('roadmap.lead')}>
  <div class="container-site flex flex-col gap-space-lg py-space-md lg:gap-space-xl lg:py-space-xl">
    <header class="flex flex-col gap-1">
      <span class="eyebrow">{t('roadmap.eyebrow')}</span>
      <h1 class="text-headline-lg-mobile font-bold tracking-tight text-on-surface lg:text-headline-lg">{t('roadmap.title')}</h1>
      <p class="mt-1 max-w-2xl text-body-sm text-on-surface-variant lg:text-body-md">{t('roadmap.lead')}</p>
    </header>
    <div class="grid gap-space-lg md:grid-cols-2 xl:grid-cols-4">
      {columns.map((col) => (
        <section class="flex flex-col gap-space-sm">
          <div class="flex items-center justify-between">
            <h2 class="flex items-center gap-2 text-body-lg font-semibold text-on-surface"><Icon name={icons[col.status]} class="text-secondary" size="1.2rem" />{t(`rstatus.${col.status}` as any)}</h2>
            <span class="font-mono text-code-sm text-on-surface-variant">{col.items.length}</span>
          </div>
          <ul class="flex flex-col gap-space-sm">
            {col.items.map((i) => (
              <li class="group card card-hover relative flex flex-col gap-2 border border-transparent">
                <div class="flex items-center justify-between gap-2">
                  <StatusPill status={i.data.status} lang={lang} kind="roadmap" />
                  <ExampleBadge lang={lang} show={i.data.example} />
                </div>
                {i.data.project && <span class="font-mono text-[10px] font-semibold uppercase tracking-wider text-primary">{i.data.project}</span>}
                <h3 class="text-body-lg font-semibold text-on-surface"><a href={href(lang, `roadmap/${slugOf(i.id)}`)} class="after:absolute after:inset-0">{i.data.title}</a></h3>
                <p class="text-body-sm text-on-surface-variant">{i.data.summary}</p>
                <div class="mt-1 flex items-center justify-between">
                  <span class="inline-flex items-center gap-1.5 rounded-full border border-[#334155] bg-[#0f172a] px-3 py-1 font-mono text-code-sm text-[#94a3b8] transition-colors group-hover:text-primary">
                    <Icon name="thumb_up" size="1rem" />{t('roadmap.vote')}
                  </span>
                  <Icon name="arrow_forward" class="text-on-surface-variant" size="1.1rem" />
                </div>
              </li>
            ))}
          </ul>
        </section>
      ))}
    </div>
    <div class="flex flex-col items-start gap-3 rounded-2xl border border-violet-electric/30 bg-linear-to-br from-violet-electric/15 via-surface-container to-surface-container p-5 sm:flex-row sm:items-center sm:justify-between">
      <div>
        <h2 class="text-headline-sm font-bold text-on-surface">{t('roadmap.suggest')}</h2>
        <p class="text-body-sm text-on-surface-variant">{t('roadmap.suggest.text')}</p>
      </div>
      <a href={href(lang, 'feedback')} class="btn-primary shrink-0"><Icon name="lightbulb" size="1.1rem" />{t('roadmap.suggest.cta')}</a>
    </div>
  </div>
</Base>
