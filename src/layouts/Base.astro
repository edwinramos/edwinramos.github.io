---
import '../styles/global.css';
import { SITE, ANALYTICS, isSet } from '../config';
import { useT, type Lang } from '../i18n/ui';
import { href, asset } from '../lib/paths';
import { iconFontUrl } from '../lib/icons';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import BottomNav from '../components/BottomNav.astro';

interface Props {
  lang: Lang;
  /** path without language prefix, e.g. 'apps/foo' */
  path: string;
  title?: string;
  description?: string;
  image?: string;
  active?: string;
  type?: 'website' | 'article';
  publishedTime?: Date;
  /** override language-switch targets (e.g. when a translation doesn't exist) */
  alternates?: Partial<Record<Lang, string>>;
  noindex?: boolean;
}
const { lang, path, title, description, image, active = '', type = 'website', publishedTime, alternates: altIn = {}, noindex = false } = Astro.props;
const t = useT(lang);
const fullTitle = title ? `${title} · ${SITE.shortName}` : t('site.title');
const desc = description ?? t('site.description');
const alternates: Record<Lang, string> = { es: altIn.es ?? href('es', path), en: altIn.en ?? href('en', path) };
const canonical = new URL(href(lang, path), Astro.site);
const ogImage = new URL(asset(image ?? (lang === 'en' ? SITE.defaultOgImageEn : SITE.defaultOgImage)), Astro.site);
const ogIsDefault = !image; // the default share images are 1200×630
const personLd = {
  '@context': 'https://schema.org', '@type': 'Person', name: SITE.name, jobTitle: 'Senior Software Engineer',
  email: `mailto:${SITE.email}`, url: new URL(href(lang), Astro.site).toString(),
  address: { '@type': 'PostalAddress', addressCountry: 'DO' },
  sameAs: [SITE.linkedin, isSet(SITE.instagram) ? SITE.instagram : null, isSet(SITE.github) ? SITE.github : null].filter(Boolean),
  knowsAbout: ['.NET', 'C#', '.NET MAUI', 'Xamarin', 'ASP.NET', 'Entity Framework Core', 'REST APIs', 'AWS', 'Azure DevOps', 'React', 'Go', 'Python', 'LLM integration'],
};
---
<!doctype html>
<html lang={lang} class="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={desc} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="alternate" hreflang="es" href={new URL(alternates.es, Astro.site)} />
    <link rel="alternate" hreflang="en" href={new URL(alternates.en, Astro.site)} />
    <link rel="alternate" hreflang="x-default" href={new URL(alternates.es, Astro.site)} />
    <slot name="head" />
    <link rel="sitemap" href={asset('sitemap-index.xml')} />
    <link rel="icon" href={asset('favicon.ico')} sizes="16x16 32x32 48x48" />
    <link rel="icon" type="image/png" sizes="32x32" href={asset('favicon-32.png')} />
    <link rel="apple-touch-icon" sizes="180x180" href={asset('apple-touch-icon.png')} />
    <meta name="theme-color" content="#0b1326" />
    <meta name="author" content={SITE.name} />
    <meta name="generator" content={Astro.generator} />
    <!-- Open Graph / Twitter -->
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    {ogIsDefault && <meta property="og:image:type" content="image/png" />}
    {ogIsDefault && <meta property="og:image:width" content="1200" />}
    {ogIsDefault && <meta property="og:image:height" content="630" />}
    <meta property="og:image:alt" content={ogIsDefault ? SITE.name : fullTitle} />
    <meta property="og:locale" content={lang === 'es' ? 'es_DO' : 'en_US'} />
    <meta property="og:locale:alternate" content={lang === 'es' ? 'en_US' : 'es_DO'} />
    {publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={desc} />
    <meta name="twitter:image" content={ogImage} />
    <script type="application/ld+json" set:html={JSON.stringify(personLd)} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href={iconFontUrl()} />
    {isSet(ANALYTICS.cloudflareToken) && (
      <script is:inline defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon={JSON.stringify({ token: ANALYTICS.cloudflareToken })}></script>
    )}
  </head>
  <body class="flex min-h-screen flex-col">
    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[60] focus:rounded-lg focus:bg-primary focus:px-3 focus:py-2 focus:text-on-primary">Skip to content</a>
    <Header lang={lang} active={active} alternates={alternates} />
    <main id="main" class="relative flex w-full flex-1 flex-col pt-20">
      <slot />
    </main>
    <Footer lang={lang} />
    <BottomNav lang={lang} active={active} />
  </body>
</html>
