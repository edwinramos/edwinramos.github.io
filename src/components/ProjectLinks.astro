---
import type { CollectionEntry } from 'astro:content';
import { useT, type Lang } from '../i18n/ui';
import Icon from './Icon.astro';
interface Props { data: CollectionEntry<'projects'>['data']; lang: Lang; size?: 'sm' | 'md' }
const { data, lang, size = 'sm' } = Astro.props;
const t = useT(lang);
const links = [
  { url: data.repoUrl, icon: 'code', label: t('links.code') },
  { url: data.playStoreUrl, icon: 'shop', label: t('links.playStore') },
  { url: data.appStoreUrl, icon: 'storefront', label: t('links.appStore') },
  { url: data.betaUrl, icon: 'install_mobile', label: t('links.beta') },
  { url: data.demoUrl, icon: 'open_in_new', label: t('links.demo') },
].filter((l) => !!l.url);
---
{links.length > 0 && (
  <div class="flex flex-wrap items-center gap-2">
    {links.map((l) => (
      <a href={l.url} target="_blank" rel="noopener noreferrer" class:list={[size === 'sm' ? 'tool-link' : 'btn-ghost btn-sm']}>
        <Icon name={l.icon} size="1rem" />{l.label}
      </a>
    ))}
  </div>
)}
