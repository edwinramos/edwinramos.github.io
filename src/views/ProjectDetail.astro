---
import { render, type CollectionEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import AppIcon from '../components/AppIcon.astro';
import StatusPill from '../components/StatusPill.astro';
import TechBadges from '../components/TechBadges.astro';
import ExampleBadge from '../components/ExampleBadge.astro';
import StoreBadges from '../components/StoreBadges.astro';
import BetaSignup from '../components/BetaSignup.astro';
import { useT, type Lang } from '../i18n/ui';
import { href, asset } from '../lib/paths';
import { hasTranslation } from '../lib/content';
import { slugOf, platformName, hasPolicy } from '../lib/apps';
interface Props { lang: Lang; entry: CollectionEntry<'projects'> }
const { lang, entry } = Astro.props;
const { data } = entry;
const t = useT(lang);
const slug = slugOf(entry.id);
const other: Lang = lang === 'es' ? 'en' : 'es';
const alternates = { [other]: (await hasTranslation('projects', other, slug)) ? href(other, `apps/${slug}`) : href(other, 'apps') };
const { Content } = await render(entry);
const privacy = data.privacyUrl ? asset(data.privacyUrl) : (await hasPolicy(lang, slug)) ? href(lang, `apps/${slug}/privacy`) : undefined;
const showBeta = !!data.betaUrl || data.status !== 'live';
const inStores = !!(data.playStoreUrl || data.appStoreUrl);
const hero = data.screenshots[0];
---
<Base lang={lang} path={`apps/${slug}`} active="apps" title={data.title} description={data.summary} image={data.logo} alternates={alternates}>
  <div class="container-site flex flex-col gap-space-lg py-space-md lg:gap-space-xl lg:py-space-xl">
    <a href={href(lang, 'apps')} class="inline-flex w-fit items-center gap-1 font-mono text-label-sm text-on-surface-variant hover:text-secondary"><Icon name="arrow_back" size="1rem" />{t('nav.apps')}</a>

    <header class="grid gap-space-lg lg:grid-cols-12 lg:items-center lg:gap-space-xl">
      <div class="flex flex-col gap-space-md lg:col-span-7">
        <div class="flex items-center gap-space-sm">
          <AppIcon logo={data.logo} icon={data.icon} title={data.title} size="lg" />
          <div class="flex flex-wrap items-center gap-1.5">
            <StatusPill status={data.status} label={data.statusLabel} lang={lang} />
            <ExampleBadge lang={lang} show={data.example} />
          </div>
        </div>
        <h1 class="text-headline-lg-mobile font-extrabold tracking-tight text-on-surface sm:text-display-mobile lg:text-display">{data.title}</h1>
        <p class="text-body-md text-on-surface-variant lg:max-w-2xl lg:text-body-lg">{data.summary}</p>
        {data.platforms.length > 0 && (
          <div class="flex flex-wrap items-center gap-1.5 font-mono text-[11px] text-on-surface-variant">
            <span class="text-outline">{t('apps.platforms')}:</span>{data.platforms.map((p) => <span class="rounded bg-surface-container-high px-2 py-0.5">{platformName[p]}</span>)}
          </div>
        )}
        <div class="flex flex-wrap items-center gap-2">
          <StoreBadges entry={entry} lang={lang} />
          {showBeta && <a href="#beta" class:list={[inStores ? 'btn-ghost' : 'btn-primary', 'py-2.5']}><Icon name="install_mobile" size="1.1rem" />{t('apps.beta')}</a>}
          {data.websiteUrl && <a href={data.websiteUrl} target="_blank" rel="noopener noreferrer" class="btn-ghost py-2.5"><Icon name="open_in_new" size="1.1rem" />{t('apps.website')}</a>}
        </div>
        {!inStores && !data.statusLabel && data.platforms.some((p) => p === 'android' || p === 'ios') && <p class="font-mono text-[11px] text-outline">{t('apps.soonStores')}</p>}
      </div>
      <div class="lg:col-span-5">
        {hero ? (
          <div class="mx-auto w-56 rounded-[2.2rem] border border-white/10 bg-surface-container-lowest p-2 shadow-[0_20px_60px_rgba(139,92,246,0.25)] sm:w-64">
            <img src={asset(hero)} alt={`${data.title} — ${t('apps.screenshots')} 1`} class="aspect-[9/19.5] w-full rounded-[1.8rem] object-cover" />
          </div>
        ) : (
          <div class="flex h-48 w-full items-center justify-center rounded-2xl bg-surface-container-low bg-[radial-gradient(circle_at_30%_20%,rgba(208,188,255,0.25),transparent_60%),radial-gradient(circle_at_80%_80%,rgba(123,208,255,0.2),transparent_55%)] sm:h-64">
            <AppIcon logo={data.logo} icon={data.icon} title={data.title} size="lg" />
          </div>
        )}
      </div>
    </header>

    {data.whatsNew && (
      <section class="rounded-2xl border border-secondary/25 bg-linear-to-br from-secondary/10 via-surface-container to-surface-container p-5 lg:p-6">
        <h2 class="flex items-center gap-2 text-headline-sm font-semibold text-on-surface"><Icon name="new_releases" class="text-secondary" size="1.3rem" />{t('apps.whatsNew')}</h2>
        <p class="mt-2 whitespace-pre-line text-body-md text-on-surface-variant">{data.whatsNew}</p>
      </section>
    )}

    {data.screenshots.length > 0 && (
      <section class="flex flex-col gap-space-sm" aria-labelledby="shots">
        <h2 id="shots" class="flex items-center gap-2 text-headline-sm font-semibold text-on-surface"><Icon name="photo_library" class="text-secondary" size="1.25rem" />{t('apps.screenshots')}</h2>
        <ul class="no-scrollbar -mx-4 flex snap-x snap-mandatory gap-space-sm overflow-x-auto px-4 pb-2 lg:mx-0 lg:px-0">
          {data.screenshots.map((s, i) => (
            <li class="w-40 shrink-0 snap-start sm:w-48">
              <a href={asset(s)} target="_blank" rel="noopener"><img src={asset(s)} alt={`${data.title} — ${t('apps.screenshots')} ${i + 1}`} loading="lazy" decoding="async" class="aspect-[9/19.5] w-full rounded-2xl border border-white/[0.08] object-cover" /></a>
            </li>
          ))}
        </ul>
      </section>
    )}

    <div class="grid gap-space-lg lg:grid-cols-12 lg:gap-space-xl">
      <section class="flex flex-col gap-space-sm lg:col-span-8">
        <h2 class="text-headline-sm font-semibold text-on-surface">{t('apps.about')}</h2>
        <div class="prose prose-site"><Content /></div>
      </section>
      <aside class="flex flex-col gap-space-md lg:col-span-4">
        {data.tags.length > 0 && <div class="card"><span class="section-tag">{t('apps.stack')}</span><div class="mt-2"><TechBadges tags={data.tags} /></div></div>}
        {privacy && (
          <a href={privacy} class="card card-hover flex items-center gap-2 border border-transparent text-body-md font-semibold text-on-surface">
            <Icon name="shield" class="text-secondary" size="1.25rem" />{t('apps.privacy')}<Icon name="arrow_forward" class="ml-auto text-on-surface-variant" size="1.1rem" />
          </a>
        )}
      </aside>
    </div>

    {showBeta && <BetaSignup entry={entry} lang={lang} />}
  </div>
</Base>
