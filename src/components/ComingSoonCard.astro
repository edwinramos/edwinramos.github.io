---
/** Empty state for the app grid. */
import { useT, type Lang } from '../i18n/ui';
import Icon from './Icon.astro';
import SocialLinks from './SocialLinks.astro';
interface Props { lang: Lang; class?: string }
const { lang, class: cls = '' } = Astro.props;
const t = useT(lang);
---
<div class:list={['flex flex-col items-start justify-center gap-space-sm rounded-2xl border border-dashed border-outline-variant/60 bg-surface-container-low/60 p-space-md sm:p-6', cls]}>
  <span class="flex h-11 w-11 items-center justify-center rounded-xl bg-surface-container-highest text-primary"><Icon name="rocket_launch" size="1.5rem" /></span>
  <h3 class="text-headline-sm font-bold text-on-surface">{t('soon.title')}</h3>
  <p class="max-w-xl text-body-sm text-on-surface-variant">{t('soon.text')}</p>
  <SocialLinks size="sm" email={false} class="pt-1" />
</div>
