---
/** Contact: a direct mailto link plus social links (no form). */
import { SITE } from '../config';
import { useT, type Lang } from '../i18n/ui';
import SocialLinks from './SocialLinks.astro';
import Icon from './Icon.astro';
interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useT(lang);
---
<section id="contact" class="flex scroll-mt-28 flex-col gap-space-sm rounded-2xl border border-white/[0.06] bg-surface-container p-5 lg:p-8">
  <h2 class="flex items-center gap-2 text-headline-md font-bold text-on-surface"><Icon name="mail" class="text-secondary" size="1.5rem" />{t('contact.title')}</h2>
  <p class="text-body-md text-on-surface-variant">{t('contact.lead')}</p>
  <div class="mt-1 flex flex-wrap items-center gap-space-sm">
    <a class="btn-primary max-w-full" href={`mailto:${SITE.email}`}><Icon name="mail" size="1.1rem" /><span class="truncate">{SITE.email}</span></a>
    <SocialLinks email={false} />
  </div>
</section>
