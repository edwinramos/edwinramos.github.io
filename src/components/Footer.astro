---
import { SITE } from '../config';
import { useT, type Lang } from '../i18n/ui';
import { href } from '../lib/paths';
import SocialLinks from './SocialLinks.astro';
interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useT(lang);
const year = new Date().getFullYear();
const links = [
  { path: 'apps', label: t('nav.apps') },
  { path: '#contact', label: t('nav.contact') },
  { path: 'privacy', label: t('nav.privacy') },
];
---
<footer class="mt-space-2xl w-full bg-surface-container-low pb-28 lg:pb-10">
  <div class="container-site flex flex-col gap-space-md py-space-lg sm:flex-row sm:items-center sm:justify-between">
    <SocialLinks size="sm" />
    <nav aria-label="Footer">
      <ul class="flex flex-wrap gap-x-6 gap-y-2">
        {links.map((l) => <li><a class="text-body-sm text-on-surface-variant transition-colors hover:text-secondary" href={href(lang, l.path)}>{l.label}</a></li>)}
      </ul>
    </nav>
  </div>
  <div class="container-site">
    <div class="border-t border-outline-variant/30 pt-space-md text-center font-mono text-label-sm text-outline sm:text-left">© {year} {SITE.name}</div>
  </div>
</footer>
