---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import SectionHeader from '../components/SectionHeader.astro';
import ProjectCard from '../components/ProjectCard.astro';
import CurrentlyBuilding from '../components/CurrentlyBuilding.astro';
import { useT, type Lang } from '../i18n/ui';
import { href, formatDate } from '../lib/paths';
import { byLang, slugOf } from '../lib/content';
interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useT(lang);
const projects = (await byLang('projects', lang)).sort((a, b) => a.data.order - b.data.order);
const current = projects.find((p) => p.data.current);
const posts = (await byLang('posts', lang)).sort((a, b) => +b.data.date - +a.data.date).slice(0, 3);
const cats = [...new Set(projects.map((p) => p.data.category))];
---
<Base lang={lang} path="projects" active="projects" title={t('projects.title')} description={t('projects.lead')}>
  <div class="container-site flex flex-col gap-space-lg py-space-md lg:gap-space-xl lg:py-space-xl">
    <header class="flex flex-col gap-1">
      <span class="eyebrow">{t('projects.eyebrow')}</span>
      <h1 class="text-headline-lg-mobile font-bold tracking-tight text-on-surface lg:text-headline-lg">{t('projects.title')}</h1>
      <p class="mt-1 max-w-2xl text-body-sm text-on-surface-variant lg:text-body-md">{t('projects.lead')}</p>
    </header>

    {current && (
      <section class="flex flex-col gap-space-sm">
        <div class="flex items-center justify-between">
          <div class="flex items-center gap-2"><span class="h-2.5 w-2.5 animate-pulse rounded-full bg-secondary"></span><h2 class="text-headline-sm font-semibold text-on-surface">{t('home.building')}</h2></div>
          <span class="rounded-full bg-secondary/15 px-2.5 py-0.5 font-mono text-label-sm text-secondary">{t('projects.inProgress')}</span>
        </div>
        <CurrentlyBuilding entry={current} lang={lang} variant="spotlight" />
      </section>
    )}

    <section class="flex flex-col gap-space-md">
      <div class="flex flex-col gap-space-xs">
        <div class="flex items-center justify-between">
          <h2 class="text-headline-sm text-on-surface">{t('projects.catalog')}</h2>
          <span class="font-mono text-code-sm text-on-surface-variant"><span id="count">{projects.length}</span> {t('common.records')}</span>
        </div>
        <div class="no-scrollbar flex items-center gap-1.5 overflow-x-auto py-1" id="catalog-filters" role="toolbar" aria-label="Filter">
          <button type="button" data-filter="all" aria-pressed="true" class="filter-btn">{t('common.all')} <span class="rounded-full bg-on-primary/20 px-1.5 text-[10px]">{projects.length}</span></button>
          {cats.map((c) => <button type="button" data-filter={c} aria-pressed="false" class="filter-btn">{t(`cat.${c}` as any)}</button>)}
        </div>
      </div>
      <div class="grid gap-space-md sm:grid-cols-2 lg:grid-cols-3" id="projects-container">
        {projects.map((p) => <ProjectCard entry={p} lang={lang} />)}
      </div>
    </section>

    <section class="flex flex-col gap-space-sm">
      <SectionHeader icon="history_edu" title={lang === 'es' ? 'Bitácora de Actualizaciones' : 'Update Log'} tag={t('common.viewAll')} tagHref={href(lang, 'blog')} />
      <ol class="card flex flex-col divide-y divide-outline-variant/30 p-0 sm:p-0">
        {posts.map((p) => (
          <li class="flex gap-3 p-4">
            <Icon name="check_circle" class="mt-0.5 text-secondary" size="1.25rem" fill />
            <div class="min-w-0 flex-1">
              <div class="flex items-start justify-between gap-2">
                <a href={href(lang, `blog/${slugOf(p.id)}`)} class="font-semibold text-on-surface hover:text-primary">{p.data.project ? `${p.data.project}${p.data.version ? ` · ${p.data.version}` : ''}` : p.data.title}</a>
                <span class="shrink-0 font-mono text-[11px] text-outline">{formatDate(p.data.date, lang, { month: 'short', day: 'numeric' })}</span>
              </div>
              <p class="text-body-sm text-on-surface-variant">{p.data.description}</p>
            </div>
          </li>
        ))}
      </ol>
    </section>
  </div>
</Base>

<style is:global>
  .filter-btn { display: inline-flex; flex-shrink: 0; align-items: center; gap: .25rem; border-radius: 9999px; padding: .375rem .75rem; font-family: var(--font-mono); font-size: var(--text-label-sm); font-weight: 600; letter-spacing: .06em; background: var(--color-surface-container); color: var(--color-on-surface-variant); transition: background-color .15s, color .15s; }
  .filter-btn:hover { color: var(--color-on-surface); }
  .filter-btn[aria-pressed='true'] { background: var(--color-primary); color: var(--color-on-primary); }
</style>
<script>
  const btns = document.querySelectorAll<HTMLButtonElement>('#catalog-filters .filter-btn');
  const items = document.querySelectorAll<HTMLElement>('#projects-container .project-item');
  const count = document.getElementById('count');
  btns.forEach((b) => b.addEventListener('click', () => {
    const f = b.dataset.filter;
    btns.forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
    let n = 0;
    items.forEach((i) => { const show = f === 'all' || i.dataset.category === f; i.hidden = !show; if (show) n++; });
    if (count) count.textContent = String(n);
  }));
</script>
