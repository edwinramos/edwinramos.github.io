---
import View from '../../../views/RoadmapDetail.astro';
import { byLang, slugOf } from '../../../lib/content';
export async function getStaticPaths() {
  const entries = await byLang('roadmap', 'en');
  return entries.map((entry) => ({ params: { slug: slugOf(entry.id) }, props: { entry } }));
}
const { entry } = Astro.props;
---
<View lang="en" entry={entry} />
