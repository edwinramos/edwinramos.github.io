---
/**
 * Formspree-backed form (free tier). The endpoint comes from src/config.ts › FORMS.
 * Without an endpoint it falls back to opening the visitor's email app (mailto:).
 */
import { FORMS, SITE, formAction } from '../config';
import { useT, type Lang } from '../i18n/ui';
import Icon from './Icon.astro';
interface Props { kind: keyof typeof FORMS; lang: Lang; subject: string; submitLabel?: string; class?: string; compact?: boolean }
const { kind, lang, subject, submitLabel, class: cls = '', compact = false } = Astro.props;
const t = useT(lang);
const action = formAction(kind);
---
<form
  class:list={['js-form flex flex-col gap-space-md', cls]}
  action={action ?? `mailto:${SITE.email}?subject=${encodeURIComponent(subject)}`}
  method="POST"
  enctype={action ? undefined : 'text/plain'}
  data-ajax={action ? 'true' : undefined}
>
  <input type="hidden" name="form" value={kind} />
  <input type="hidden" name="_subject" value={subject} />
  <input type="hidden" name="lang" value={lang} />
  <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" class="hidden" aria-hidden="true" />
  <slot />
  {!compact && !action && (
    <p class="flex items-start gap-2 rounded-xl border border-dashed border-amber-400/40 bg-amber-400/5 p-3 font-mono text-code-sm text-amber-200">
      <Icon name="construction" size="1rem" class="mt-0.5" />{t('form.notConfigured')}
    </p>
  )}
  {!compact && (
    <div class="flex flex-wrap items-center gap-3">
      <button type="submit" class="btn-primary"><Icon name="send" size="1.1rem" /><span data-label>{submitLabel ?? t('form.send')}</span></button>
      <p class="js-form-status text-body-sm" role="status" aria-live="polite" data-ok={t('form.ok')} data-err={t('form.err')} data-sending={t('form.sending')}></p>
    </div>
  )}
</form>

<script>
  document.querySelectorAll<HTMLFormElement>('form.js-form[data-ajax]').forEach((form) => {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const status = form.querySelector<HTMLElement>('.js-form-status');
      const btn = form.querySelector<HTMLButtonElement>('button[type=submit]');
      const say = (key: 'ok' | 'err' | 'sending', cls: string) => {
        if (!status) return;
        status.textContent = status.dataset[key] ?? '';
        status.className = `js-form-status text-body-sm ${cls}`;
      };
      btn?.setAttribute('disabled', '');
      say('sending', 'text-on-surface-variant');
      try {
        const res = await fetch(form.action, { method: 'POST', body: new FormData(form), headers: { Accept: 'application/json' } });
        if (!res.ok) throw new Error(String(res.status));
        form.reset();
        say('ok', 'text-emerald-400');
      } catch {
        say('err', 'text-error');
      } finally {
        btn?.removeAttribute('disabled');
      }
    });
  });
</script>
