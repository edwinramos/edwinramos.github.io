---
/**
 * Giscus = comments/reactions stored in GitHub Discussions (free).
 * Config in src/config.ts › GISCUS. Renders a "coming soon" box until repoId + categoryId are filled.
 *  - mode 'comments': blog posts (one discussion per page pathname)
 *  - mode 'votes':    roadmap items (one discussion per item; 👍 reactions = votes)
 */
import { GISCUS } from '../config';
import { useT, type Lang } from '../i18n/ui';
import Icon from './Icon.astro';
interface Props { lang: Lang; mode?: 'comments' | 'votes'; term?: string }
const { lang, mode = 'comments', term } = Astro.props;
const t = useT(lang);
const category = mode === 'votes' ? GISCUS.roadmapCategory : GISCUS.category;
const categoryId = mode === 'votes' ? GISCUS.roadmapCategoryId : GISCUS.categoryId;
const ready = !!GISCUS.repoId && !!categoryId && !GISCUS.repo.includes('TU-USUARIO');
---
{ready ? (
  <div class="giscus rounded-2xl bg-surface-container-low p-3 sm:p-5">
    <script is:inline src="https://giscus.app/client.js" async crossorigin="anonymous"
      data-repo={GISCUS.repo}
      data-repo-id={GISCUS.repoId}
      data-category={category}
      data-category-id={categoryId}
      data-mapping={term ? 'specific' : 'pathname'}
      data-term={term}
      data-strict="1"
      data-reactions-enabled="1"
      data-emit-metadata="0"
      data-input-position="top"
      data-theme="transparent_dark"
      data-lang={lang}
      data-loading="lazy"></script>
  </div>
) : (
  <div class="flex items-start gap-3 rounded-2xl border border-dashed border-outline-variant/60 bg-surface-container-low p-5">
    <Icon name={mode === 'votes' ? 'thumb_up' : 'forum'} class="text-primary" size="1.5rem" />
    <div>
      <p class="font-semibold text-on-surface">{t('giscus.pending.title')}</p>
      <p class="text-body-sm text-on-surface-variant">{t('giscus.pending.text')}</p>
    </div>
  </div>
)}
