---
import { getEntry, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import SectionHeader from '../components/SectionHeader.astro';
import ExampleBadge from '../components/ExampleBadge.astro';
import { SITE, isSet } from '../config';
import { useT, type Lang } from '../i18n/ui';
import { href, asset } from '../lib/paths';
interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useT(lang);
const profile = (await getEntry('profile', lang))!;
const { Content } = await render(profile);
const p = profile.data;
const accents = ['text-secondary', 'text-primary', 'text-tertiary'];
const channels = [
  { icon: 'mail', label: 'Email', value: SITE.email, url: `mailto:${SITE.email}` },
  { icon: 'share', label: 'LinkedIn', value: 'edwin-ramos-madera', url: SITE.linkedin },
  ...(isSet(SITE.github) ? [{ icon: 'code', label: 'GitHub', value: SITE.github.replace('https://github.com/', '@'), url: SITE.github }] : []),
  { icon: 'rss_feed', label: 'RSS', value: 'Devlog', url: asset(lang === 'en' ? 'en/rss.xml' : 'rss.xml') },
];
---
<Base lang={lang} path="about" active="about" title={t('nav.about')} description={`${SITE.name} — ${p.role}. ${p.specialty}.`}>
  <div class="container-site grid gap-space-lg py-space-md lg:grid-cols-12 lg:gap-space-xl lg:py-space-xl">
    <!-- Profile card -->
    <aside class="lg:col-span-4">
      <div class="card-raised flex flex-col items-center gap-space-md text-center lg:sticky lg:top-28">
        <div class="relative mt-2">
          <img src={asset('images/avatar.svg')} alt={SITE.name} width="96" height="96" class="h-24 w-24 rounded-full shadow-[0_0_0_2px_rgba(208,188,255,0.5),0_0_30px_rgba(139,92,246,0.35)]" />
          <span class="absolute bottom-1 right-1 h-4 w-4 rounded-full border-2 border-surface-container bg-emerald-400"></span>
        </div>
        <div class="flex flex-col items-center gap-1">
          <h1 class="flex items-center gap-2 text-headline-md font-bold text-on-surface">{SITE.shortName} <span class="rounded bg-primary/15 px-1.5 py-0.5 font-mono text-[10px] text-primary">PRO</span></h1>
          <p class="text-body-md font-semibold text-secondary">{p.role}</p>
          <p class="text-body-sm text-on-surface-variant">{p.specialty}</p>
          <p class="flex items-center gap-1 text-body-sm text-on-surface-variant"><Icon name="location_on" size="1rem" class="text-primary" />{p.location}</p>
        </div>
        <div class="grid w-full grid-cols-3 gap-space-xs">
          {p.stats.map((s) => (
            <div class="flex flex-col items-center rounded-xl bg-surface-container-high px-1 py-3">
              <span class="font-mono text-body-md font-bold text-on-surface">{s.value}</span>
              <span class="mt-0.5 font-mono text-[10px] text-on-surface-variant">{s.label}</span>
            </div>
          ))}
        </div>
        <div class="flex w-full flex-col gap-space-xs">
          {SITE.cvUrl && <a href={asset(SITE.cvUrl)} class="btn-primary w-full" download><Icon name="download" size="1.25rem" />{t('about.cv')}</a>}
          <a href={href(lang, 'services#contact')} class:list={['w-full', SITE.cvUrl ? 'btn-ghost' : 'btn-primary']}><Icon name="mail" size="1.25rem" />{t('about.contact')}</a>
        </div>
      </div>
    </aside>

    <div class="flex flex-col gap-space-xl lg:col-span-8">
      <!-- Intro -->
      <section class="flex flex-col gap-space-sm">
        <span class="eyebrow">{t('about.eyebrow')}</span>
        <h2 class="text-headline-lg-mobile font-bold tracking-tight text-on-surface lg:text-headline-lg">{t('about.intro')}</h2>
        <div class="prose prose-site lg:prose-lg"><Content /></div>
      </section>

      <!-- What I do -->
      {p.focus.length > 0 && (
        <section class="flex flex-col gap-space-sm">
          <SectionHeader icon="rocket_launch" iconClass="text-primary" title={t('about.focus')} tag={t('about.focus.tag')} />
          <div class="grid gap-space-sm md:grid-cols-2">
            {p.focus.map((f, i) => (
              <article class="card-raised card-hover flex flex-col gap-space-sm">
                <span class:list={['flex h-11 w-11 items-center justify-center rounded-xl bg-surface-container-highest', accents[i % 3]]}><Icon name={f.icon} size="1.5rem" /></span>
                <h3 class="text-headline-sm font-bold text-on-surface">{f.title}</h3>
                <p class="text-body-sm text-on-surface-variant">{f.description}</p>
                {f.points.length > 0 && (
                  <ul class="flex flex-col gap-1.5">
                    {f.points.map((pt) => <li class="flex items-start gap-2 text-body-sm text-on-surface"><Icon name="check" class="mt-0.5 text-emerald-400" size="1rem" />{pt}</li>)}
                  </ul>
                )}
              </article>
            ))}
          </div>
        </section>
      )}

      <!-- How I work -->
      {p.approach.length > 0 && (
        <section class="flex flex-col gap-space-sm">
          <SectionHeader icon="sync" title={t('about.approach')} tag={t('about.approach.tag')} />
          <ul class="grid gap-space-sm sm:grid-cols-2 lg:grid-cols-3">
            {p.approach.map((ap, i) => (
              <li class="card flex flex-col gap-1.5">
                <div class="flex items-center justify-between gap-2">
                  <Icon name={ap.icon} class={accents[i % 3]} size="1.35rem" />
                  <ExampleBadge lang={lang} show={ap.example} />
                </div>
                <h3 class="text-body-lg font-semibold text-on-surface">{ap.title}</h3>
                <p class="text-body-sm text-on-surface-variant">{ap.description}</p>
              </li>
            ))}
          </ul>
        </section>
      )}

      <!-- Skills -->
      <section class="flex flex-col gap-space-sm">
        <SectionHeader icon="apps" title={t('about.skills')} tag={t('about.skills.tag')} />
        <div class="grid gap-space-sm md:grid-cols-2">
          {p.skills.map((s, i) => (
            <div class="flex flex-col gap-2 rounded-xl bg-surface-container p-space-md">
              <div class="flex items-center gap-2"><Icon name={s.icon} class={accents[i % 3]} size="1.2rem" /><h3 class="text-body-md font-semibold text-on-surface">{s.title}</h3></div>
              <p class="text-body-sm text-on-surface-variant">{s.description}</p>
              <ul class="flex flex-wrap gap-1.5 pt-1">
                {s.items.map((it, j) => <li class:list={['rounded-lg bg-surface-container-high px-2.5 py-1 font-mono text-label-sm', j === 0 ? `${accents[i % 3]} font-semibold` : 'text-on-surface']}>{it}</li>)}
              </ul>
            </div>
          ))}
        </div>
      </section>

      {p.education.length > 0 && (
        <section class="flex flex-col gap-space-sm">
          <SectionHeader icon="verified" iconClass="text-tertiary" title={t('about.education')} tag={t('about.education.tag')} />
          <div class="grid gap-space-xs md:grid-cols-2">
            {p.education.map((ed) => (
              <div class="flex items-center gap-space-sm rounded-xl bg-surface-container p-space-md">
                <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-surface-container-highest text-primary"><Icon name={ed.icon} size="1.4rem" /></div>
                <div class="flex min-w-0 flex-col">
                  <span class="text-body-md font-semibold text-on-surface">{ed.title}</span>
                  {ed.subtitle && <span class="text-body-sm text-on-surface-variant">{ed.subtitle}</span>}
                </div>
                <span class="ml-auto"><ExampleBadge lang={lang} show={ed.example} /></span>
              </div>
            ))}
          </div>
        </section>
      )}

      {p.languages.length > 0 && (
        <section class="flex flex-col gap-space-sm">
          <SectionHeader icon="translate" title={t('about.languages')} tag="I18N" />
          <div class="grid grid-cols-1 gap-space-xs sm:grid-cols-3">
            {p.languages.map((l) => (
              <div class="flex items-center justify-between rounded-xl bg-surface-container p-space-md">
                <div class="flex flex-col"><span class="text-body-md font-semibold text-on-surface">{l.name}</span><span class="text-body-sm text-on-surface-variant">{l.level}</span></div>
                <Icon name="language" class="text-secondary" size="1.2rem" />
              </div>
            ))}
          </div>
        </section>
      )}

      <section class="flex flex-col gap-space-sm">
        <SectionHeader icon="hub" title={t('about.channels')} tag={t('about.channels.tag')} />
        <div class="grid grid-cols-2 gap-space-xs md:grid-cols-4">
          {channels.map((c) => (
            <a href={c.url} target={c.url.startsWith('http') ? '_blank' : undefined} rel="me noreferrer" class="card card-hover flex items-center gap-3 border border-transparent p-3 sm:p-4">
              <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-surface-container-highest text-secondary"><Icon name={c.icon} size="1.2rem" /></span>
              <span class="flex min-w-0 flex-col"><span class="text-body-sm font-semibold text-on-surface">{c.label}</span><span class="truncate font-mono text-[11px] text-on-surface-variant">{c.value}</span></span>
            </a>
          ))}
        </div>
      </section>
      <!-- CTA -->
      <section class="flex flex-col items-start gap-3 rounded-2xl border border-violet-electric/30 bg-linear-to-br from-violet-electric/15 via-surface-container to-surface-container p-5 sm:flex-row sm:items-center sm:justify-between lg:p-8">
        <div>
          <h2 class="text-headline-sm font-bold text-on-surface lg:text-headline-md">{t('about.cta.title')}</h2>
          <p class="text-body-sm text-on-surface-variant lg:text-body-md">{t('about.cta.text')}</p>
        </div>
        <div class="flex shrink-0 flex-wrap gap-2">
          <a href={href(lang, 'services')} class="btn-ghost"><Icon name="handshake" class="text-secondary" size="1.1rem" />{t('nav.services')}</a>
          <a href={href(lang, 'services#contact')} class="btn-primary"><Icon name="mail" size="1.1rem" />{t('nav.hire')}</a>
        </div>
      </section>
    </div>
  </div>
</Base>
